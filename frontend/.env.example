NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
BACKEND_API_URL=http://localhost:8000

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
# Register an app at https://developer.kroger.com/ with Products and Locations access.
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
# Server-side scraper and CLI writes; never expose these in NEXT_PUBLIC_ variables.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Instacart discovery and optional shopping-list handoff.
INSTACART_API_KEY=
# Use development until you have a production API key and launch approval.
INSTACART_API_ENV=development
# Comma-separated custom Shopify store domains eligible for preloaded cart links.
# myshopify.com subdomains work without configuration; product links need ?variant=ID.
NEXT_PUBLIC_SHOPIFY_STOREFRONTS=
# Local station pump prices: Places API (New) requires billing/account setup.
GOOGLE_MAPS_API_KEY=
# Explicitly opt in only after configuring quota/billing limits.
GOOGLE_PLACES_ENABLED=false
# Optional authorized multi-retailer feed. See docs/grocery-price-feed.md.
GROCERY_PRICE_FEED_URL=
GROCERY_PRICE_FEED_KEY=
# Server-only provider key. Does not enable branch pricing until validated.
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_SERP_ZONE=
# Optional verified product URLs: {"Retailer":{"item name":["https://..."]}}
BRIGHT_DATA_PRODUCT_URLS={}
# Optional AI discovery for products missing a known URL. Server-only.
OPENAI_API_KEY=
OPENAI_SEARCH_MODEL=gpt-5.5
OLLAMA_SEARCH_MODEL=llama3.2:3b
# Lifetime for hosted collection jobs, separate from the interactive search window.
STRETCH_SEARCH_TIMEOUT_MS=90000
# Interactive search: 30 seconds server-side, 35 seconds browser-side (lib/search-timing.ts).
